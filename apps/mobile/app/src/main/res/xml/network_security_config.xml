<?xml version="1.0" encoding="utf-8"?>
<!--
  The hosted CRM (Vercel) is reached over HTTPS. Plain HTTP stays allowed so the app can also talk to a
  CRM running on the office network during development (e.g. http://192.168.1.4:3000).
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
